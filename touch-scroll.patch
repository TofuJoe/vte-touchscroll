+/* Whether the gesture's current sequence comes from a touchscreen. */
+static bool
+sequence_is_touch(GtkGestureClick* gesture)
+{
+        auto const sequence = gtk_gesture_single_get_current_sequence(GTK_GESTURE_SINGLE(gesture));
+        auto const event = gtk_gesture_get_last_event(GTK_GESTURE(gesture), sequence);
+        if (!event)
+                return false;
+
+        switch (gdk_event_get_event_type(event)) {
+        case GDK_TOUCH_BEGIN:
+        case GDK_TOUCH_UPDATE:
+        case GDK_TOUCH_END:
+                return true;
+        default:
+                break;
+        }
+
+        auto const device = gdk_event_get_device(event);
+        return device && gdk_device_get_source(device) == GDK_SOURCE_TOUCHSCREEN;
+}
