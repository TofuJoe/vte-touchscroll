@@ -1360,6 +1382,17 @@ Widget::gesture_click_pressed(GtkGestureClick* gesture,
         // FIXMEgtk4 why does gtk4 not do that automatically?
         gtk_widget_grab_focus(gtk());
 
+        // Touch sequences are swallowed here without ever producing anything
+        // useful, which starves the pan gesture of a containing
+        // GtkScrolledWindow, so a finger drag cannot scroll the scrollback.
+        // Deny them so they propagate and the scrolled window can kinetically
+        // scroll instead. The long press gesture is a separate gesture and is
+        // unaffected, so the touch context menu keeps working.
+        if (sequence_is_touch(gesture)) {
+                gtk_gesture_set_state(GTK_GESTURE(gesture), GTK_EVENT_SEQUENCE_DENIED);
+                return;
+        }
+
